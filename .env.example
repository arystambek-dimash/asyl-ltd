# Скопируйте в .env и задайте свои значения.
# Суперпользователь создаётся автоматически при первом подъёме Docker.
DOMAIN=asyl-ltd.kz
CERTBOT_EMAIL=admin@asyl-ltd.kz
CERTBOT_STAGING=0

SECRET_KEY=change-me-generate-a-long-random-string
POSTGRES_DB=asyl
POSTGRES_USER=asyl
POSTGRES_PASSWORD=change-me-db-password
# Сколько секунд переиспользовать соединение с Postgres. 0 — открывать заново
# на каждый запрос (заметно медленнее). Живые соединения: воркеры gunicorn
# плюс по одному на каждый монитор.
DB_CONN_MAX_AGE=60

ALLOWED_HOSTS=asyl-ltd.kz,www.asyl-ltd.kz,78.40.109.240
CORS_ALLOWED_ORIGINS=https://asyl-ltd.kz,https://www.asyl-ltd.kz
CSRF_TRUSTED_ORIGINS=https://asyl-ltd.kz,https://www.asyl-ltd.kz
NEXT_PUBLIC_API_URL=/api

# Celery reuses the deployed Redis server but keeps broker data separate from
# Django's cache database. There is intentionally no result-backend variable.
CELERY_BROKER_URL=redis://redis:6379/1

# Observability. Every integration is disabled while its DSN is empty. CI
# supplies the immutable commit as APP_RELEASE for production; local runs use
# the development fallback below.
APP_RELEASE=development
# This file is the production-server template. Local compose supplies its own
# development default when APP_ENVIRONMENT is unset.
APP_ENVIRONMENT=production
LOG_LEVEL=INFO
# Local default is readable; production compose forces JSON stdout.
LOG_FORMAT=readable

# Django error tracking. Request bodies and default PII are disabled in code.
SENTRY_BACKEND_DSN=
# Sentry Logs is separate from error tracking and is opt-in due to privacy and
# ingestion volume. Structured stdout remains enabled when this is 0.
SENTRY_ENABLE_LOGS=0
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# Browser DSNs are public by design and are embedded at image build time.
# Browser-side errors work without giving the frontend container Internet
# access. Replay and profiling stay disabled; tracing is also off by default.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLE_LOGS=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Next server/edge reporting is deliberately disabled. Even with a DSN, the
# production frontend has no outbound route; enable only with controlled egress.
SENTRY_FRONTEND_SERVER_DSN=
SENTRY_FRONTEND_ENABLE_LOGS=0
SENTRY_FRONTEND_TRACES_SAMPLE_RATE=0
SENTRY_FRONTEND_PROFILES_SAMPLE_RATE=0

# Non-secret source-map coordinates used during the frontend image build.
SENTRY_ORG=
SENTRY_PROJECT_FRONTEND=
# SENTRY_AUTH_TOKEN belongs only in the GitHub Actions secret store and is
# mounted into the build as a BuildKit secret. Never put it in this file.

SUPER_ADMIN_EMAIL=admin@example.com
# Задайте уникальный длинный пароль; слабый пароль остановит startup.
SUPER_ADMIN_PASS=
SUPER_ADMIN_RESET_PASSWORD=0

# ApiPay (только backend; реальные секреты не коммитить).
# Webhook URL в кабинете: https://asyl-ltd.kz/api/webhooks/apipay/
APIPAY_API_KEY=
APIPAY_WEBHOOK_SECRET=
APIPAY_BASE_URL=https://api.apipay.kz/api/v1
APIPAY_TIMEOUT_SECONDS=10
# Фоновая сверка счетов и возвратов. Монитор жёстко ограничен 100 из
# документированных 200 запросов/мин; остальная половина остаётся рабочим
# операциям. Значение 80 даёт дополнительный запас.
APIPAY_RECONCILE_INTERVAL_SECONDS=30
APIPAY_RECONCILE_STALE_SECONDS=30
APIPAY_RECONCILE_LOOKBACK_HOURS=72
APIPAY_RECONCILE_BATCH_SIZE=100
APIPAY_REFUND_RECONCILE_LIMIT=25
APIPAY_REFUND_ORPHAN_GRACE_SECONDS=900
APIPAY_REFUND_SWEEP_STALE_SECONDS=900
APIPAY_MONITOR_REQUEST_BUDGET_PER_MINUTE=80
APIPAY_MONITOR_MAX_BACKOFF_SECONDS=300
# Redis singleton lease retained across an explicit Celery retry chain. Keep
# this longer than the maximum backoff plus one bounded iteration.
APIPAY_RECONCILE_TASK_LOCK_SECONDS=1200
APIPAY_MONITOR_HEARTBEAT_FILE=/tmp/apipay-monitor-heartbeat
APIPAY_MONITOR_HEARTBEAT_MAX_AGE_SECONDS=600

# WireGuard для удалённого доступа к камерам.
# Если камеры в другой LAN-подсети, замените 192.168.1.0/24 на реальную подсеть камер.
WG_SERVERURL=78.40.109.240
WG_SERVERPORT=51820
WG_PEERS=operatorlaptop
WG_PEERDNS=1.1.1.1
WG_INTERNAL_SUBNET=10.13.13.0
WG_ALLOWEDIPS=10.13.13.0/24,192.168.1.0/24
WG_PERSISTENTKEEPALIVE_PEERS=all

# Камеры цеха (go2rtc): RTSP-прокси MediaMTX на ПК с камерами (Tailscale).
CAMERA_HOST=100.109.156.107
CAMERA_USER=viewer
CAMERA_PASS=change-me-viewer-password
# Публичный UDP-кандидат go2rtc для прямого WebRTC-видео в браузер.
# На сервере порт 8555/udp должен быть открыт в firewall.
GO2RTC_WEBRTC_CANDIDATE=78.40.109.240:8555

# End-to-end camera monitor (MediaMTX -> Tailscale -> go2rtc -> real JPEG frame).
CAMERA_EXPECTED_COUNT=10
CAMERA_MINIMUM_ONLINE_COUNT=5
CAMERA_MONITOR_INTERVAL_SECONDS=30
CAMERA_HEALTH_STALE_SECONDS=180
CAMERA_FAILURE_THRESHOLD=3
CAMERA_DEGRADED_THRESHOLD=3
CAMERA_RECOVERY_THRESHOLD=2

# Optional external incident delivery. Leave blank until a trusted destination
# is configured on the production server; no token should be committed to git.
CAMERA_ALERT_WEBHOOK_URL=
CAMERA_ALERT_WEBHOOK_TOKEN=
CAMERA_ALERT_TELEGRAM_BOT_TOKEN=
CAMERA_ALERT_TELEGRAM_CHAT_ID=
# URLs are derived from CAMERA_HOST by default. Override them only if the AI or
# playback APIs are exposed on another host.
AI_SERVICE_URL=
# Backend-only plaintext key. It must match the SHA-256 digest stored on the
# camera PC and must never be exposed as NEXT_PUBLIC_*.
AI_SERVICE_API_KEY=replace-with-long-random-backend-only-secret
# Must exceed edge PREWARM (15s) + conveyor command verification (3s).
AI_SERVICE_TIMEOUT=25
CAMERA_PLAYBACK_URL=

# Управление ESP32 через исходящий HTTPS polling. Активная привязка ESP32 к
# камере автоматически включает серверное управление для новых сессий этой
# камеры. Digest ниже аутентифицирует OFF-only счётчик с camera-PC.
CONVEYOR_AI_CALLBACK_TOKEN_SHA256=
CONVEYOR_DEVICE_SYNC_MS=500
CONVEYOR_DEVICE_LEASE_MS=1200
CONVEYOR_DEVICE_FRESH_MS=1500
CONVEYOR_AI_STALE_MS=1500
CONVEYOR_COMMAND_TIMEOUT_SECONDS=5
CONVEYOR_NO_PROGRESS_SECONDS=15
CONVEYOR_MAX_RUN_SECONDS=300
# Production compatibility bridge is active for cam2; set empty to disable it.
CONVEYOR_LEGACY_BRIDGE_CAMERAS=cam2
CONVEYOR_LEGACY_BRIDGE_POLL_MS=250
CONVEYOR_LEGACY_BRIDGE_REQUEST_TIMEOUT_MS=350
CONVEYOR_LEGACY_BRIDGE_STALE_MS=750
CONVEYOR_LEGACY_BRIDGE_DEVICE_SYNC_MS=250
CONVEYOR_LEGACY_BRIDGE_DEVICE_LEASE_MS=750
THROTTLE_CONVEYOR_DEVICE=180/min
THROTTLE_CONVEYOR_AI=6000/min

# Физические весы видит только backend через Tailscale; никогда не используйте
# NEXT_PUBLIC_* для этих адресов. В локальной разработке оставляйте пустыми.
# Железнодорожные весы для прихода вагонов.
WAGON_SCALE_API_URL=
# Автовесы для «Оформить вывоз»; пусто = вывоз fail-closed.
TRUCK_SCALE_API_URL=
TRUCK_SCALE_TIMEOUT_SECONDS=3
# Быстрое чтение только для экранного табло; сохранение использует timeout выше.
TRUCK_SCALE_PREVIEW_TIMEOUT_SECONDS=1
TRUCK_SCALE_MAX_AGE_SECONDS=5
TRUCK_SCALE_MAX_WEIGHT_KG=100000
# Запас только для первичного и ручного обновления; фонового polling нет.
THROTTLE_TRUCK_SCALE_PREVIEW=30/min
