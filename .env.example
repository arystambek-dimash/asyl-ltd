# Скопируйте в .env и задайте свои значения.
# Суперпользователь создаётся автоматически при первом подъёме Docker.
CERTBOT_EMAIL=admin@asyl-ltd.kz
CERTBOT_STAGING=0

SECRET_KEY=change-me-generate-a-long-random-string
POSTGRES_DB=asyl
POSTGRES_USER=asyl
POSTGRES_PASSWORD=change-me-db-password
# Сколько секунд переиспользовать соединение с Postgres. 0 — открывать заново
# на каждый запрос (заметно медленнее). Живые соединения: воркеры gunicorn
# плюс по одному на каждый включённый monitor-контейнер.
DB_CONN_MAX_AGE=60

ALLOWED_HOSTS=asyl-ltd.kz,www.asyl-ltd.kz,78.40.109.240
CORS_ALLOWED_ORIGINS=https://asyl-ltd.kz,https://www.asyl-ltd.kz
CSRF_TRUSTED_ORIGINS=https://asyl-ltd.kz,https://www.asyl-ltd.kz

# Celery reuses the deployed Redis server but keeps broker data separate from
# Django's cache database. There is intentionally no result-backend variable.
CELERY_BROKER_URL=redis://redis:6379/1

# Observability. Every integration is disabled while its DSN is empty. CI
# supplies the immutable commit as APP_RELEASE for production; local runs use
# the development fallback below.
APP_RELEASE=development
# This file is the production-server template. Local compose supplies its own
# development default when APP_ENVIRONMENT is unset.
APP_ENVIRONMENT=production
LOG_LEVEL=INFO
# Local default is readable; production compose forces JSON stdout.
LOG_FORMAT=readable

# Django error tracking. Request bodies and default PII are disabled in code.
SENTRY_BACKEND_DSN=
# Sentry Logs is separate from error tracking and is opt-in due to privacy and
# ingestion volume. Structured stdout remains enabled when this is 0.
SENTRY_ENABLE_LOGS=0
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# Browser DSNs are public by design and are embedded at image build time.
# Browser-side errors work without giving the frontend container Internet
# access. Replay and profiling stay disabled; tracing is also off by default.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLE_LOGS=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Non-secret source-map coordinates used during the frontend image build.
SENTRY_ORG=
SENTRY_PROJECT_FRONTEND=
# SENTRY_AUTH_TOKEN belongs only in the GitHub Actions secret store and is
# mounted into the build as a BuildKit secret. Never put it in this file.

SUPER_ADMIN_EMAIL=admin@example.com
# Задайте уникальный длинный пароль; слабый пароль остановит startup.
SUPER_ADMIN_PASS=
SUPER_ADMIN_RESET_PASSWORD=0

# ApiPay (только backend; реальные секреты не коммитить).
# Webhook URL в кабинете у каждого ключа: https://asyl-ltd.kz/api/webhooks/apipay/
# Ключи по отделам задаёт суперюзер в «Заказы → Отделы → Kaspi / ApiPay».
# Две переменные ниже нужны только разовой миграции sales.0004 (перенос
# старого общего ключа в основной отдел); после неё их можно убрать.
APIPAY_API_KEY=
APIPAY_WEBHOOK_SECRET=
APIPAY_BASE_URL=https://api.apipay.kz/api/v1
APIPAY_TIMEOUT_SECONDS=10
# Фоновая сверка счетов и возвратов. Монитор жёстко ограничен 100 из
# документированных 200 запросов/мин; остальная половина остаётся рабочим
# операциям. Значение 80 даёт дополнительный запас.
APIPAY_RECONCILE_INTERVAL_SECONDS=30
APIPAY_RECONCILE_STALE_SECONDS=30
APIPAY_RECONCILE_LOOKBACK_HOURS=72
APIPAY_RECONCILE_BATCH_SIZE=100
APIPAY_REFUND_RECONCILE_LIMIT=25
APIPAY_REFUND_ORPHAN_GRACE_SECONDS=900
APIPAY_REFUND_SWEEP_STALE_SECONDS=900
APIPAY_MONITOR_REQUEST_BUDGET_PER_MINUTE=80
APIPAY_MONITOR_MAX_BACKOFF_SECONDS=300
# Redis singleton lease retained across an explicit Celery retry chain. Keep
# this longer than the maximum backoff plus one bounded iteration.
APIPAY_RECONCILE_TASK_LOCK_SECONDS=1200
APIPAY_MONITOR_HEARTBEAT_FILE=/tmp/apipay-monitor-heartbeat
APIPAY_MONITOR_HEARTBEAT_MAX_AGE_SECONDS=600

# Камеры цеха (go2rtc): RTSP-прокси MediaMTX на ПК с камерами (Tailscale).
CAMERA_HOST=100.109.156.107
CAMERA_USER=viewer
CAMERA_PASS=change-me-viewer-password
# Публичный UDP-кандидат go2rtc для прямого WebRTC-видео в браузер.
# На сервере порт 8555/udp должен быть открыт в firewall.
GO2RTC_WEBRTC_CANDIDATE=78.40.109.240:8555

# End-to-end camera monitor (MediaMTX -> Tailscale -> go2rtc -> real JPEG frame).
CAMERA_EXPECTED_COUNT=10
CAMERA_MINIMUM_ONLINE_COUNT=5
CAMERA_MONITOR_INTERVAL_SECONDS=30
CAMERA_HEALTH_STALE_SECONDS=180
CAMERA_FAILURE_THRESHOLD=3
CAMERA_DEGRADED_THRESHOLD=3
CAMERA_RECOVERY_THRESHOLD=2

# Optional external incident delivery. Leave blank until a trusted destination
# is configured on the production server; no token should be committed to git.
CAMERA_ALERT_WEBHOOK_URL=
CAMERA_ALERT_WEBHOOK_TOKEN=
CAMERA_ALERT_TELEGRAM_BOT_TOKEN=
CAMERA_ALERT_TELEGRAM_CHAT_ID=
# URLs are derived from CAMERA_HOST by default. Override them only if the AI or
# playback APIs are exposed on another host.
AI_SERVICE_URL=
# Backend-only plaintext key. It must match the SHA-256 digest stored on the
# camera PC and must never be exposed as NEXT_PUBLIC_*.
# Required (32-512 printable ASCII) before weight-first vehicle mode can start.
AI_SERVICE_API_KEY=replace-with-long-random-backend-only-secret
# Must exceed edge PREWARM (15s).
AI_SERVICE_TIMEOUT=25
# Import independent camera journals concurrently (1–8). Pages stay ordered.
CAMERA_EVENT_SYNC_WORKERS=2

# Отгрузки: отдельный worker группирует события счёта в сессии и отрезки.
# Вагоны: сразу OpenAI. Грузовики: одна OCR-проверка, затем OpenAI при неудаче.
# Обе схемы используют сохранённый кадр старта отрезка.
# Импорт, снимки и OCR работают независимо. Простой настраивается в CRM (5 мин.).
# Локально worker запускается только с Compose profile hardware.
SHIPPING_TRANSPORT_POLL_SECONDS=2
SHIPPING_TRANSPORT_HEARTBEAT_FILE=/tmp/shipping-transport-monitor/heartbeat.json
# Контроль живого цикла; медленные OCR-запросы не задерживают heartbeat.
SHIPPING_TRANSPORT_HEARTBEAT_MAX_AGE_SECONDS=180

# Inbound HTTPS webhook from the camera-PC vehicle plate detector. Generate a
# separate long random production token; never reuse AI_SERVICE_API_KEY.
VEHICLE_PLATE_WEBHOOK_TOKEN=
VEHICLE_PLATE_WEBHOOK_MAX_BODY_BYTES=65536
THROTTLE_VEHICLE_PLATE_WEBHOOK=120/min
# Weight-first поток: стабильный вес запускает on-demand OCR.
VEHICLE_PLATE_WEIGHT_FIRST_ENABLED=0
VEHICLE_PLATE_WEIGHT_FIRST_CAMERA=cam1
VEHICLE_PLATE_WEIGHT_FIRST_SOURCE=main
VEHICLE_PLATE_WEIGHT_FIRST_TIMEOUT_SECONDS=12
# Автоматический scale-first monitor работает отдельным контейнером и остаётся
# выключенным, пока реальный проезд с обязательным освобождением весов между
# двумя фиксациями не проверен на месте. 0 — мгновенный kill switch бизнес-логики.
VEHICLE_PLATE_AUTO_SCALE_ENABLED=0
VEHICLE_PLATE_AUTO_SCALE_POLL_SECONDS=1
# Весы считаются освободившимися только после нескольких показаний не выше
# этого порога. Занятый вес должен оставаться стабильным 2–60 секунд; значение
# хранится в БД, по умолчанию равно 10 и меняется суперпользователем в интерфейсе.
VEHICLE_PLATE_AUTO_SCALE_EMPTY_MAX_KG=500
VEHICLE_PLATE_AUTO_SCALE_CLEAR_CONFIRM_POLLS=3
# Допустимый шум между подтверждающими стабильными показаниями.
VEHICLE_PLATE_AUTO_SCALE_STABLE_TOLERANCE_KG=50
VEHICLE_PLATE_AUTO_SCALE_REARM_DELTA_KG=1000
# Container-private heartbeat проверяет только жизнь цикла. Недоступные весы
# или камера дают degraded, но не откатывают здоровый релиз приложения. Возраст
# должен покрывать poll + оба scale timeout + OCR timeout + запас на запись БД.
VEHICLE_PLATE_AUTO_SCALE_HEARTBEAT_FILE=/tmp/passage-scale-monitor/heartbeat.json
VEHICLE_PLATE_AUTO_SCALE_HEARTBEAT_MAX_AGE_SECONDS=60
VEHICLE_PLATE_AUTO_EXPORT_CARGO_NAME=Отруби
VEHICLE_PLATE_AUTO_EXPORT_MIN_TRIP_SECONDS=60
# Ночная выгрузка датасета «перед/зад» на ПК камер; 0 — выключить.
VEHICLE_ORIENTATION_DATASET_ENABLED=1

# Физические весы видит только backend через Tailscale; никогда не используйте
# NEXT_PUBLIC_* для этих адресов. В локальной разработке оставляйте пустыми.
# Вагонные весы под аркой разгрузки (vesyv, CAS Weight API). Их читает только
# независимый wagon-collector (deploy/weighbridge/), не основное приложение,
# поэтому здесь значение оставляем ПУСТЫМ. Реальный Tailscale-адрес задаётся
# в .env сервера; он задокументирован в deploy/weighbridge/README.md.
WAGON_SCALE_API_URL=
# Независимая автоматизация wagon-collector (deploy/weighbridge/): CRM
# импортирует его события только пока флаг включён. 0 — мгновенный kill switch.
WAGON_ARCH_AUTOMATION_ENABLED=0
WAGON_ARCH_CAMERA=cam8
# Порог прибытия: зона неподвижна WAGON_ARCH_STILL_SECONDS и вес стабилен
# WAGON_ARCH_STABLE_SECONDS в пределах WAGON_ARCH_STABLE_TOLERANCE_KG.
WAGON_ARCH_STILL_SECONDS=10
WAGON_ARCH_STABLE_SECONDS=2
WAGON_ARCH_STABLE_TOLERANCE_KG=100
# Вес не больше WAGON_ARCH_EMPTY_MAX_KG — вагона под аркой нет; скачок вверх
# на WAGON_ARCH_NEXT_WAGON_RISE_KG — приехал следующий, предыдущий уехал.
WAGON_ARCH_EMPTY_MAX_KG=1000
WAGON_ARCH_NEXT_WAGON_RISE_KG=5000
# Проба движения старше WAGON_ARCH_MOTION_MAX_AGE_SECONDS считается «unknown».
WAGON_ARCH_MOTION_MAX_AGE_SECONDS=5
# Распознавание номера вагона: до WAGON_ARCH_OCR_MAX_ATTEMPTS попыток с паузой
# WAGON_ARCH_OCR_RETRY_SECONDS, каждая со свежим кадром cam8main.
WAGON_ARCH_OCR_RETRY_SECONDS=15
WAGON_ARCH_OCR_MAX_ATTEMPTS=4
# Сторона CRM: сколько отъезд ждёт возможной пересдачи, прежде чем выходной
# вес запишется в рейс (60—3600). Приезд следующего вагона закрывает раньше.
WAGON_ARCH_EXIT_GRACE_SECONDS=600
# Автовесы для «Оформить вывоз». В production используется
# http://desktop-t5p32d3:8000/api/v1/weight; пусто = вывоз fail-closed.
TRUCK_SCALE_API_URL=
TRUCK_SCALE_TIMEOUT_SECONDS=3
# Быстрое чтение только для экранного табло; сохранение использует timeout выше.
TRUCK_SCALE_PREVIEW_TIMEOUT_SECONDS=1
TRUCK_SCALE_MAX_AGE_SECONDS=5
TRUCK_SCALE_MAX_WEIGHT_KG=100000
# Лимит относится только к browser-preview API; server-side monitor
# читает весы напрямую и под DRF throttle не попадает.
THROTTLE_TRUCK_SCALE_PREVIEW=60/min

# OpenAI checks saved weighbridge and shipping photos.
# Keep the key only in the server .env, never in Git or NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
WEIGHING_AI_ENABLED=1
WEIGHING_AI_MODEL=gpt-5-mini
# Shipping wagon OCR only; empty inherits WEIGHING_AI_MODEL.
# Also accepted as an optional GitHub Actions repository variable on deploy.
SHIPPING_WAGON_AI_MODEL=
# Only high/original; original requires a model that supports that detail level.
SHIPPING_WAGON_AI_DETAIL=high
# Truck OCR fallback keeps WEIGHING_AI_MODEL and high detail.
WEIGHING_AI_MAX_DAILY_REQUESTS=200
WEIGHING_AI_ENTRY_MAX_HOURS=12

# WhatsApp-бот отчётов о вагонах (Green-API, сервис whatsapp-bot). Опрос
# очереди уведомлений — публичный вебхук не нужен. В кабинете Green-API
# у инстанса включите входящие сообщения (incomingWebhook) и статус номера
# (stateWebhook). Все переменные необязательны: без WHATSAPP_BOT_ENABLED=1
# процесс простаивает; без ключей включённый бот пишет «degraded». Какие
# чаты и отправители разрешены, — в CRM: «Управление → WhatsApp-бот».
# «Отправить отчёт» в истории грузчика (вкладка «Вагоны»): бот включён здесь
# и в журнале и его процесс работает (свежий удачный круг, номер authorized) —
# отчёт уходит ботом на номер получателя из настроек бота («Динара»), а без
# номера — в первую разрешённую группу. Иначе грузчику открывается WhatsApp с
# готовым текстом (отправляет он сам).
WHATSAPP_BOT_ENABLED=0
# Адрес API инстанса (https://7103.api.greenapi.com); пусто — https://api.green-api.com.
WHATSAPP_BOT_API_URL=
WHATSAPP_BOT_INSTANCE_ID=
WHATSAPP_BOT_API_TOKEN=
WHATSAPP_BOT_RECEIVE_TIMEOUT_SECONDS=20
WHATSAPP_BOT_HEARTBEAT_MAX_AGE_SECONDS=180
# Черновик ИИ для сообщений не по формату (OPENAI_API_KEY выше); бот по
# черновику не проводит — только человек в журнале.
WHATSAPP_BOT_LLM_ENABLED=0
# Пусто — WEIGHING_AI_MODEL.
WHATSAPP_BOT_LLM_MODEL=
