# Store only this SHA-256 digest on camera-PC. Never put the plaintext backend
# AI_SERVICE_API_KEY into this file.
AI_SERVICE_API_KEY_SHA256=replace_with_64_lowercase_hex_characters
AI_MODEL_PATH=C:\mediamtx\ai-service\models\best.pt
AI_MODEL_DEVICE=0
AI_BIND_HOST=0.0.0.0
AI_BIND_PORT=8890
AI_MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
AI_MEDIAMTX_API_URL=http://127.0.0.1:9997
AI_FFMPEG_PATH=C:\mediamtx\ffmpeg.exe
AI_MAX_ACTIVE_PROCESSORS=2
AI_PREWARM_CAMERAS=cam2
AI_PREWARM_SOURCE=sub
AI_INFERENCE_FPS=8
AI_OUTPUT_FPS=12
AI_FRAME_QUEUE_SIZE=2
AI_PREWARM_TIMEOUT=15
AI_CAPTURE_TIMEOUT_MS=3000
AI_CONFIDENCE=0.35
AI_DEFAULT_LINE=0,0.5,1,0.5
AI_WAGON_FRAME_MAX_BYTES=12582912

# Optional fail-safe ESP32 Modbus/TCP mapping. Register addresses are zero-based.
# Smart mode requires a separate contactor auxiliary-input feedback register.
AI_CONVEYOR_CONTROLLERS_JSON={"cam2":{"host":"<ESP32-IP>","port":502,"unit_id":1,"register_type":"holding","address":0,"on_value":1,"off_value":0,"feedback_register_type":"holding","feedback_address":1,"feedback_on_value":1,"feedback_off_value":0}}

# Alternative cloud ESP mode (never combine the same camera with the direct
# mapping above). The edge only sends signed AI observations; it never writes
# an output and has no physical readback in this mode.
AI_CONVEYOR_CLOUD_CAMERAS=
AI_CONVEYOR_CLOUD_API_URL=https://asyl-ltd.kz/api/conveyors/v1/ai/observation/
AI_CONVEYOR_CLOUD_API_KEY=
AI_CONVEYOR_HEARTBEAT_SECONDS=0.5
AI_CONVEYOR_STALE_AI_SECONDS=1.5
AI_CONVEYOR_NO_PROGRESS_SECONDS=15.0
AI_CONVEYOR_MAX_RUN_SECONDS=300.0
AI_CONVEYOR_IO_TIMEOUT_SECONDS=0.5
AI_CONVEYOR_COMMAND_TIMEOUT_SECONDS=3.0
